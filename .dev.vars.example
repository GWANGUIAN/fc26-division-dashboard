# For local `wrangler dev` only. Never commit a real ORIGIN_AUTH_TOKEN.
API_ORIGIN_URL=https://replace-with-reader.lambda-url.ap-northeast-2.on.aws/
ORIGIN_AUTH_TOKEN=replace-with-a-long-random-value

# Optional: enables minigame run-token checks locally (any random value).
SCORE_TOKEN_SECRET=replace-with-any-random-value
